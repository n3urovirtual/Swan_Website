# Security headers for every response.
#
# The policy is strict because the site earns it: no inline <style> or <script>
# anywhere, no style="" attributes, no third-party scripts, and every font,
# image and library served from this origin. If you ever add an inline block,
# this policy will block it — move it to a file rather than loosening the rule.

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'none'; manifest-src 'self'
